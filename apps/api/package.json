{
	"name": "api",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"db:migrate:create": "wrangler d1 migrations create DB",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:apply": "wrangler d1 migrations apply DB --remote",
		"db:migrate:status": "wrangler d1 migrations list DB --remote",
		"db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
		"db:setup:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=./seed.sql"
	},
	"dependencies": {
		"better-auth": "^1.6.0",
		"chanfana": "^2.6.3",
		"hono": "^4.12.3",
		"jose": "^6.1.3",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.13.0",
		"@types/service-worker-mock": "^2.0.4",
		"csv-parse": "^6.1.0",
		"wrangler": "^4.68.1"
	}
}
