{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "test": "node --import tsx --test src/**/*.test.ts tests/*.test.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:create": "wrangler d1 migrations create DB",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:apply": "wrangler d1 migrations apply DB --remote",
    "db:migrate:status": "wrangler d1 migrations list DB --remote",
    "db:seed:local": "tsx scripts/seed-more.ts",
    "db:seed:more": "tsx scripts/seed-more.ts",
    "db:setup:local": "wrangler d1 migrations apply DB --local && tsx scripts/seed-more.ts",
    "typecheck": "tsc --noEmit",
    "measure:rows": "tsx scripts/measure-rows-read.ts"
  },
  "dependencies": {
    "chanfana": "^2.6.3",
    "hono": "^4.12.3",
    "jose": "^6.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^22.13.0",
    "csv-parse": "^6.1.0",
    "tsx": "^4.23.1",
    "wrangler": "^4.68.1",
    "typescript": "^5.9.3"
  }
}
